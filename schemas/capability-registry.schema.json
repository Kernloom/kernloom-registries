{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernloom.io/schemas/capability-registry.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "kernloom.io/registry/v1alpha1" },
    "kind": { "const": "CapabilityRegistry" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "category", "domain", "runtimeAction", "allowedPaths"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "category": { "enum": ["observe", "assess", "decide", "enforce", "export", "manage"] },
              "effect": { "enum": ["restrictive", "grant", "observe", "assess", "context_dependent"] },
              "runtimeAction": { "type": "boolean" },
              "severity": { "type": "integer", "minimum": 0, "maximum": 3 },
              "allowedPaths": { "type": "array", "items": { "enum": ["runtime", "config", "report", "proposal"] } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  }
}

