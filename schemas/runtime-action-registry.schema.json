{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernloom.io/schemas/runtime-action-registry.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "kernloom.io/registry/v1alpha1" },
    "kind": { "const": "RuntimeActionRegistry" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["levels", "requirements", "revertStrategies", "conflictPolicies"],
      "properties": {
        "levels": { "type": "array", "items": { "type": "object", "required": ["id", "maxSeverity"] } },
        "bounds": { "type": "array", "items": { "type": "object", "required": ["id", "maxSeverity"] } }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  }
}

